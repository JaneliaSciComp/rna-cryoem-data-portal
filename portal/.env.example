# Copy to .env (git-ignored). Shell syntax: pixi sources it before every backend task, and
# $PIXI_PROJECT_ROOT is this folder, so paths work whatever directory a task runs in.
CATALOG_DB_URL=postgresql+psycopg://postgres:test@localhost:55432/portal
CATALOG_DATA_ROOT=$PIXI_PROJECT_ROOT/../.scratch/drive-data
CATALOG_THUMBNAIL_DIR=$PIXI_PROJECT_ROOT/../.scratch/caches/thumbnails
# No nginx locally: the API sends file bodies itself (gallery images, Mol* models).
CATALOG_SERVE_FILES=1
